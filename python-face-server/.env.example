# Face Recognition Server Configuration

# Model Configuration
MODEL_NAME=ArcFace
# Options: VGG-Face, Facenet, Facenet512, ArcFace, Dlib
# Recommended: ArcFace (best accuracy: 99.86%)

DETECTOR_BACKEND=retinaface
# Options: opencv, ssd, dlib, mtcnn, retinaface
# Recommended: retinaface (best accuracy: 99%+)

# Thresholds
MATCH_THRESHOLD=0.68
# Lower = more strict (0.6-0.7 recommended for ArcFace)

LIVENESS_THRESHOLD=0.7
# Liveness detection confidence threshold (0.7 recommended)

MIN_FACE_SIZE=80
# Minimum face size in pixels

# Server Configuration
PORT=5000
# Server port (default: 5000)
